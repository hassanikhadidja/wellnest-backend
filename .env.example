# Copy to .env for local development.
# MongoDB (any one of these names works)
uri=mongodb://USER:PASSWORD@host/WellnestDB?ssl=true&authSource=admin
# MONGODB_URI=
# MONGO_URI=

# JWT (any one of these names works)
secretKey=replace-with-a-long-random-secret
# JWT_SECRET=
# SECRET_KEY=

PORT=5002

# Optional: comma-separated list. Empty = reflect any origin (dev-friendly).
CORS_ORIGINS=http://localhost:3000

# Seeded admin (created automatically if missing)
ADMIN_EMAIL=admin@wellnest.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin Wellnest

# Cloudinary (optional — uploads fall back to data URLs if unset)
CLOUDINARY_NAME=
CLOUDINARY_APIKEY=
CLOUDINARY_APISECRET=
